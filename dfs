GOAL = (1, 2, 3, 4, 5, 6, 7, 8, 0)
MOVES = {
    0: (1, 3),    1: (0, 2, 4), 2: (1, 5),
    3: (0, 4, 6), 4: (1, 3, 5, 7), 5: (2, 4, 8),
    6: (3, 7),    7: (4, 6, 8), 8: (5, 7)
}

def dfs(start, max_depth=10):
    stack = [(start, [start])]
    visited = set()

    while stack:
        state, path = stack.pop()

        if state == GOAL:
            return path

        if len(path) - 1 < max_depth and state not in visited:
            visited.add(state)
            zero = state.index(0)

            for move in MOVES[zero]:
                b = list(state)
                b[zero], b[move] = b[move], b[zero]
                stack.append((tuple(b), path + [tuple(b)]))

    return None
start_board = (1, 2, 3, 4, 5, 0, 7, 8, 6)
solution = dfs(start_board)

if solution:
    print(f"Solved in {len(solution) - 1} moves:")
    for board in solution:
        print(board[:3])
        print(board[3:6])
        print(board[6:])
        print("---")
